{
  "name": "links-of-interest-ms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/links-of-interest-ms/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "links-of-interest-ms:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "links-of-interest-ms:build:development"
        },
        "production": {
          "buildTarget": "links-of-interest-ms:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/links-of-interest-ms",
        "main": "apps/links-of-interest-ms/src/main.ts",
        "tsConfig": "apps/links-of-interest-ms/tsconfig.app.json",
        "assets": [
          {
            "input": "apps/links-of-interest-ms/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ]
      },
      "configurations": {
        "development": {
          "sourceMap": true
        },
        "production": {
          "sourceMap": false
        }
      }
    }
  }
}
